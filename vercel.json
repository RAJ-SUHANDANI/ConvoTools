{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm ci --no-audit --no-fund",
  "git": {
    "deploymentEnabled": {
      "redesign": false
    }
  },
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"redesign\" ]; then exit 0; else exit 1; fi"
}
